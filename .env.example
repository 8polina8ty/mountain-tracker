# Browser + SSR Supabase access
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase administration used by public expedition resolution.
# Prefer the current secret key from the Supabase project settings.
# The code also supports SUPABASE_SERVICE_ROLE_KEY as a legacy fallback.
SUPABASE_SECRET_KEY=

# High-entropy server-only secret used to encrypt opaque public media handles.
PUBLIC_EXPEDITION_MEDIA_SECRET=

# Canonical production origin, for example https://mountain-tracker.example
SITE_URL=

# Optional local development tunnel hostname, without scheme.
DEV_TUNNEL_HOST=

# Development-only, server-gated Phase 9 OSM staging preview. Production is
# hard-disabled in code even if these values are set. IDs are Supabase Auth UUIDs.
OSM_STAGING_PREVIEW_ENABLED=false
OSM_STAGING_PREVIEW_USER_IDS=
