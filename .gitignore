# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local editor settings
.vscode/

# local SQLTools / database session files
*.session.sql

# local python environment
.venv/
venv/

# large local geodata
date/*.osm.pbf
date/boundaries/*.geojson

# isolated OpenStreetMap bulk-ingestion inputs and generated artifacts
/data/osm/source/*.osm.pbf
/data/osm/alps/*.jsonl
/data/osm/alps/summary.json
/data/osm/alps/checkpoints/

# local Phase 8A boundary source and normalized geometry (mixed open licences)
/data/osm/boundaries/source/
/data/osm/boundaries/*.geojson

# GraphHopper local runtime artifacts (keep config, ignore generated cache/index)
/data/routes/graphhopper/**/graph-cache/
/data/routes/graphhopper/**/candidate-index.json
/data/routes/graphhopper/**/candidate-index-meta.json
/data/routes/graphhopper/**/candidates-filtered.osm.pbf
/data/routes/graphhopper/**/graph-meta.json
/data/routes/graphhopper-runs/
/data/routes/pbf/
/data/routes/publication-execution/
/data/osm/alps/staging/

